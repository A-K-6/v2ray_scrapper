# v2rays environment template.
#
# DOCKER: copy to `.env` next to docker-compose.yml (`make init` does this).
# STANDALONE (`v2rays` binary): settings live in ~/.config/v2rays/.env,
# managed via `v2rays config init` and `v2rays token gen`. The standalone
# binary ignores the repo-local .env and uses XDG paths + built-in defaults
# unless the variables below are exported or present in ~/.config/v2rays/.env.
# Without REDIS_URL, sources/sites persist in a local registry.json file.

# Server
# Port published on the host by Docker Compose
HOST_PORT=8084
LISTEN_ADDR=0.0.0.0:8084

# Sources: comma-separated or a JSON string array
SUB_URLS=["https://raw.githubusercontent.com/Epodonios/v2ray-configs/main/Sub1.txt","https://raw.githubusercontent.com/barry-far/V2ray-config/main/Sub1.txt","https://raw.githubusercontent.com/ebrasha/free-v2ray-public-list/refs/heads/main/V2Ray-Config-By-EbraSha.txt"]

# sing-box testing
SING_BOX_PATH=/usr/local/bin/sing-box
LATENCY_TEST_URL=https://www.google.com/generate_204
FETCH_TIMEOUT=20
TEST_TIMEOUT=6
TEST_ATTEMPTS=2
SING_BOX_START_TIMEOUT=5
BATCH_SIZE=100
MAX_CONCURRENT_BATCHES=10
MAX_CONCURRENT_TESTS=100
BASE_PORT=20000
MAX_DELAY_MS=10000
MAX_FAIL_COUNT=3

# Scheduling and persistence
CACHE_INTERVAL_SECONDS=600
SITE_CACHE_TTL_SECONDS=86400
STATE_FILE_PATH=/data/state.json
GEOIP_DB_PATH=/app/Country.mmdb
YAML_CONFIG_PATH=/app/config.yaml
REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=v2ray-scrapper

# Required for POST/DELETE management routes. Leave empty to disable them.
MANAGEMENT_TOKEN=

# Upper bound for one refresh; tune downward on smaller hosts.
MAX_CANDIDATES=10000

# Optional stricter low-bandwidth mode
LOW_INTERNET_CONS=false
LOW_INTERNET_LIMIT=50

# Standalone overrides (binary only; Docker Compose ignores these):
# V2RAYS_CONFIG_DIR=~/.config/v2rays   # config.yaml + .env location
# V2RAYS_DATA_DIR=~/.local/share/v2rays # state.json, registry.json, sing-box
# V2RAYS_SKIP_SINGBOX_DOWNLOAD=1        # never auto-download sing-box (tests/CI)

# Optional Git publishing
GITHUB_PUSH_ENABLED=false
GITHUB_MAIN_PUSH_ENABLED=true
GITHUB_SITE_PUSH_ENABLED=true
GITHUB_REPO_URL=https://github.com/your-username/your-subscription-repo.git
GITHUB_TOKEN=
GITHUB_USER=UpdaterBot
GITHUB_EMAIL=bot@example.com
GITHUB_BRANCH=main
GITHUB_FILENAME=subscription.txt
GITHUB_REPO_DIR=/data/subscription_repo
